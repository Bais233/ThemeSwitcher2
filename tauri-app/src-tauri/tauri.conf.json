{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThemeSwitcher2",
  "version": "2.0.0",
  "identifier": "com.bais233.themeswitcher2",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ThemeSwitcher2",
        "width": 1180,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 760,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
